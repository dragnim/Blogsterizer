# Copy this file to .env and put your key in it. .env is gitignored.
#
# The key is only used for the optional AI drafting: image alt text and titles,
# and the Yoast focus keyphrase and meta description. Everything else in the app
# works without it.
#
# Get a key from https://console.anthropic.com/ -> API keys.
ANTHROPIC_API_KEY=sk-ant-...
